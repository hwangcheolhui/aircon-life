# 복사 위치: apps/web/.env.local (Next.js) · DB 명령은 셸 환경변수로 넘깁니다.
# 비밀값은 커밋하지 않습니다. Vercel에서는 프로젝트 환경변수로 입력합니다.

# ── DB (Supabase PostgreSQL) ─────────────────────────
# 서버 전용 연결. Supabase: Project Settings > Database > Connection pooling (transaction, 6543)
# 로컬: docker compose up -d db
DATABASE_URL=postgres://aircon:aircon@localhost:5432/aircon
DB_POOL_MAX=5
# 통합 테스트(RLS)·E2E 전용 DB — 테스트가 스키마를 초기화합니다
TEST_DATABASE_URL=postgres://aircon:aircon@localhost:5432/aircon_test
E2E_DATABASE_URL=postgres://aircon:aircon@localhost:5432/aircon_e2e

# ── 인증 (packages/integrations/auth) ────────────────
# supabase = Supabase Auth, mock = 로컬 파일 + 서명 쿠키(개발·테스트 전용)
AUTH_DRIVER=mock
SUPABASE_URL=
SUPABASE_ANON_KEY=
# 서버 전용(관리자 계정 생성·비밀번호 초기화). 절대 NEXT_PUBLIC_ 으로 노출하지 않습니다.
SUPABASE_SERVICE_ROLE_KEY=
# mock 전용
SESSION_SECRET=
SESSION_TTL_MIN=480
MOCK_AUTH_FILE=./storage/mock-auth.json
# 관리자 접속 IP 제한(옵션, 쉼표 구분). 비우면 제한 없음  02 §7
ADMIN_ALLOWED_IPS=
# 임시 개발 모드: true 면 로그인 없이 관리자 화면을 읽기 전용으로 열람(상단에 "임시 개발 모드" 표시).
# 구현 기간에만 사용하고 운영 전 반드시 지우거나 false 로 둔다. 저장·수정·삭제·개인정보 원문 열람은 계속 로그인 필요  02 §7
# DATABASE_URL·SESSION_SECRET 등이 아직 없어도 이 모드에서는 "DB 미연결" 안내와 함께 빈 화면이 열린다.
ADMIN_AUTH_BYPASS=false

# ── 개인정보 (ERD §6) ────────────────────────────────
# 32바이트 base64 (예: openssl rand -base64 32)
PII_ENCRYPTION_KEY=
PII_HASH_PEPPER=

# ── 첨부파일 저장소 (packages/integrations/storage) ─────
# supabase = Supabase Storage, mock = 로컬 디스크
STORAGE_DRIVER=mock
STORAGE_LOCAL_DIR=./storage/files
SUPABASE_STORAGE_BUCKET=attachments

# ── 시드 (pnpm db:seed) ──────────────────────────────
# 최초 슈퍼관리자. 비밀번호는 직접 정하고 커밋하지 마세요. AUTH_DRIVER에 맞는 인증 계정이 함께 만들어집니다.
SEED_SUPER_ADMIN_LOGIN_ID=superadmin
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=

# ── 배치 (Vercel Cron → /api/jobs/*) ─────────────────
# 임의의 긴 문자열. Vercel 프로젝트 환경변수에 같은 이름으로 넣으면 Cron 호출에 자동으로 붙는다. 비어 있으면 배치가 거부된다.
CRON_SECRET=

# ── 주소 검색 (packages/integrations/address)  단계 1 ──
# kakao = 카카오(다음) 우편번호 서비스(키 불필요, 기본값), mock = 예시 주소 목록(개발·E2E)
NEXT_PUBLIC_ADDRESS_DRIVER=kakao
# 견적 체험 모드(DATABASE_URL 이 없을 때만 동작): 서비스 가능으로 볼 법정동 코드 앞자리(쉼표 구분). 비우면 4113511000(경기 성남시 분당구 백현동 = 판교역로 166)
QUOTE_DEMO_AREA_CODES=

# ── 고객 로그인 세션  단계 2 ─────────────────────────
# 고객 앱 로그인 쿠키 서명용 임의의 긴 문자열(예: openssl rand -base64 32). 비우면 고객 로그인이 동작하지 않습니다.
CUSTOMER_SESSION_SECRET=
CUSTOMER_SESSION_DAYS=30

# ── 외부 연동 전환 (mock = 실제 호출 없이 흐름만, 개발·E2E 기본값) ──
# 결제: mock | portone   본인인증: mock | portone   소셜 로그인: mock | real   알림: mock | solapi
PAYMENT_DRIVER=mock
IDENTITY_DRIVER=mock
SOCIAL_DRIVER=mock
NOTIFY_DRIVER=mock
# mock 알림에서 true 면 알림톡 실패 → 문자 대체 흐름을 시험합니다
MOCK_NOTIFY_ALIMTALK_FAIL=false

# ── 외부 연동 키 ─────────────────────────────────────
# 카카오 (지도·로컬·로그인)  단계 1·2·4-2. 로그인 Redirect URI: https://{도메인}/auth/kakao/callback
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_JS_KEY=
# 네이버 로그인  단계 2. Callback URL: https://{도메인}/auth/naver/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 포트원 V2 (결제·본인인증)  단계 2. 결제 채널(토스페이먼츠)과 본인인증 채널 키가 따로 있습니다.
PORTONE_STORE_ID=
PORTONE_API_SECRET=
PORTONE_CHANNEL_KEY=
PORTONE_IDENTITY_CHANNEL_KEY=
# 솔라피 (알림톡·SMS)  단계 2. 알림톡은 카카오 채널 연동 ID(pfId) + 템플릿별 검수 ID(A-CRM-040)가 필요합니다.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_NUMBER=
SOLAPI_KAKAO_PF_ID=
