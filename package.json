{
  "name": "aircon-life",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @aircon/db generate",
    "db:migrate": "pnpm --filter @aircon/db migrate",
    "db:seed": "pnpm --filter @aircon/db seed",
    "e2e": "playwright test --trace off",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "prettier": "3.6.2",
    "turbo": "2.5.8",
    "typescript": "5.9.3",
    "postgres": "3.4.7"
  }
}