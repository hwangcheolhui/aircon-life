{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && npx -y pnpm@10.28.0 install --frozen-lockfile",
  "buildCommand": "cd ../.. && npx -y pnpm@10.28.0 turbo run build --filter=@aircon/web",
  "regions": [
    "icn1"
  ],
  "crons": [
    {
      "path": "/api/jobs/quote-expire",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/jobs/slot-generate",
      "schedule": "10 15 * * *"
    },
    {
      "path": "/api/jobs/visit-remind",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/jobs/area-open-notify",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/jobs/route-draft",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/jobs/route-remind",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/jobs/route-autoconfirm",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/jobs/location-purge",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/jobs/pending-overdue",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/jobs/settlement-weekly",
      "schedule": "0 21 * * 0"
    },
    {
      "path": "/api/jobs/revisit-campaign",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/jobs/daily-aggregate",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/jobs/pii-purge",
      "schedule": "0 18 * * *"
    }
  ]
}
