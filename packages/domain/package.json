{
  "name": "@aircon/domain",
  "version": "0.0.0",
  "private": true,
  "description": "프레임워크와 분리된 순수 비즈니스 로직 (06 §3). BR 규칙은 테스트로 고정한다.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./server": { "types": "./dist/server.d.ts", "default": "./dist/server.js" }
  },
  "typesVersions": { "*": { "server": ["dist/server.d.ts"] } },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "devDependencies": {
    "@aircon/config": "workspace:*",
    "@types/node": "22.19.1",
    "eslint": "9.39.1",
    "vitest": "3.2.4"
  }
}
