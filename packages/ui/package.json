    "lint": "eslint src",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "dependencies": {
    "lucide-react": "0.553.0",
    "@aircon/domain": "workspace:*"
  },
  "devDependencies": {
    "@aircon/config": "workspace:*",
    "@types/react": "19.1.17",
    "eslint": "9.39.1",
    "react": "19.1.1",
    "vitest": "3.2.4",
    "@types/node": "22.19.1"
  }
}