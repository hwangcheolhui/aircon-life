  "radius": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "20px",
    "2xl": "28px",
    "full": "9999px",
    "button": "9999px",
    "input": "12px",
    "card": "20px",
    "modal": "28px",
    "sheet": "var(--radius-2xl) var(--radius-2xl) 0 0"
  },
  "shadow": {
    "xs": "0 1px 2px rgba(20, 28, 40, 0.05)",
    "sm": "0 2px 8px rgba(20, 28, 40, 0.06)",
    "md": "0 6px 20px rgba(20, 28, 40, 0.08)",
    "lg": "0 12px 32px rgba(20, 28, 40, 0.12)",
    "xl": "0 20px 48px rgba(20, 28, 40, 0.16)",
    "fixed-bottom": "0 -4px 16px rgba(20, 28, 40, 0.06)"
