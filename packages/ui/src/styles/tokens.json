    "h-sm": "36px",
    "h-md": "44px",
    "h-lg": "52px",
    "h-xl": "56px"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "320ms",
    "ease-standard": "cubic-bezier(0.2, 0, 0, 1)",
    "ease-emphasized": "cubic-bezier(0.3, 0, 0, 1.2)"
  },
  "zIndex": {
    "base": "0",
    "sticky": "100",
    "header": "200",
    "dropdown": "300",
    "sheet": "400",
    "modal": "500",
    "toast": "600"
  },
  "breakpoint": {
    "xs": 0,
    "sm": 360,
    "md": 768,
    "lg": 1024,
    "xl": 1280,
    "2xl": 1440
  },
  "channelOverrides": {
    "tech": {
      "touch-min": "48px",
      "control-h-md": "52px",
      "control-h-xl": "64px",
      "input-h": "52px",
      "text-body-size": "16px"
    },
    "admin": {
      "control-h-md": "36px",
      "input-h": "36px",
      "radius-input": "8px",
      "radius-card": "12px",
      "text-body-size": "14px"
    }
  }
