      "size": "13px",
      "lineHeight": "1.5"
    },
    "micro": {
      "size": "12px",
      "lineHeight": "1.45"
    },
    "responsive": {
      "md(768+)": {
        "display": "40px",
        "h1": "30px",
        "h2": "24px",
        "h3": "20px"
      },
      "xl(1280+)": {
        "display": "48px",
        "h1": "34px",
        "h2": "26px"
      }
    }
