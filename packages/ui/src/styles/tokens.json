      "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
    },
    "weight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    }
  },
  "text": {
    "display": {
      "size": "32px",
      "lineHeight": "1.3"
    },
    "h1": {
      "size": "26px",
      "lineHeight": "1.35"
    },
    "h2": {
      "size": "22px",
      "lineHeight": "1.4"
